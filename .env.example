# Sample Environment Configuration for Harsh Electronics
# Copy this file to .env and configure with your actual local or AWS RDS credentials.
# NEVER commit the actual .env file or real secrets to Git.

# Server Port (5001 avoids Windows reserved exclusion port 5000)
PORT=5001

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# JWT Authentication Secret Key (Generate a strong 64-character random key in production)
# Example generation command on Linux: openssl rand -base64 48
JWT_SECRET=harsh-electronics-super-secure-production-jwt-secret-key-2026
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_DAYS=7

# Client Origin (Used for CORS in development)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
# Local PostgreSQL default port: 5432
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_NAME=harsh_electronics
DB_SSL=false

# Alternatively, configure a single connection URI (e.g. for Amazon RDS or cloud PostgreSQL):
# DATABASE_URL=postgresql://dbadmin:ComplexPassword123@harsh-rds.c123456.ap-south-1.rds.amazonaws.com:5432/harsh_electronics?sslmode=require
